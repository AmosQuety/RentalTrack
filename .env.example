# Mobile app .env.example
# Copy to .env and fill in real values before running

# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry (mobile) ─────────────────────────────────────────────────────────
# Activate Sentry by providing a DSN. See services/logger/monitoring.ts.
# EXPO_PUBLIC_SENTRY_DSN=https://your-mobile-dsn@sentry.io/project

# ── AuthHub (https://amosquety.github.io/AuthHub/) ────────────────────────────
# Base URL of your AuthHub instance (no trailing slash).
EXPO_PUBLIC_AUTHHUB_URL=https://authhub.dev
# Register a public (isConfidential: false) OAuth client in AuthHub with
# redirectUris: ["rentaltrack://oauthredirect"], then paste its clientId here.
EXPO_PUBLIC_AUTHHUB_CLIENT_ID=your-authhub-client-id
