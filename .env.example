# Mobile app .env.example
# Copy to .env and fill in real values before running

# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry (mobile) ─────────────────────────────────────────────────────────
# Activate Sentry by providing a DSN. See services/logger/monitoring.ts.
# EXPO_PUBLIC_SENTRY_DSN=https://your-mobile-dsn@sentry.io/project

# ── Backend sync API ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.rentaltrack.app
